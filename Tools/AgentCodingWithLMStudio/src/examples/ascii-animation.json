{
  "title": {
    "fr": "Ascii animation",
    "en": "ASCII Animation"
  },
  "mode": "vanilla",
  "steps": [
    {
      "title": {
        "fr": "Fullscreen ASCII Grid",
        "en": "Fullscreen ASCII Grid"
      },
      "prompt": {
        "fr": "create an ascii only animation without canvas. use letter and numbers only. make it fullscreen",
        "en": "create an ascii only animation without canvas. use letter and numbers only. make it fullscreen"
      },
      "code": {
        "fr": [
          "// Configuration du corps de la page pour le plein écran",
          "document.body.style.margin = \"0\";",
          "document.body.style.padding = \"0\";",
          "document.body.style.backgroundColor = \"#000\";",
          "document.body.style.overflow = \"hidden\";",
          "",
          "// Création de l'élément d'affichage pour l'art ASCII en plein écran",
          "const asciiDisplay = document.createElement(\"pre\");",
          "asciiDisplay.style.margin = \"0\";",
          "asciiDisplay.style.padding = \"0\";",
          "asciiDisplay.style.backgroundColor = \"#000\";",
          "asciiDisplay.style.color = \"#00ff66\";",
          "asciiDisplay.style.fontFamily = \"monospace\";",
          "asciiDisplay.style.fontSize = \"12px\";",
          "asciiDisplay.style.lineHeight = \"12px\";",
          "asciiDisplay.style.userSelect = \"none\";",
          "asciiDisplay.style.width = \"100vw\";",
          "asciiDisplay.style.height = \"100vh\";",
          "asciiDisplay.style.display = \"flex\";",
          "asciiDisplay.style.alignItems = \"center\";",
          "asciiDisplay.style.justifyContent = \"center\";",
          "document.body.appendChild(asciiDisplay);",
          "",
          "// Palette composée exclusivement de lettres et de chiffres, par densité",
          "const chars = \"17IiclotTJLOeashkXZ089BNDWM\";",
          "",
          "// Variable pour faire évoluer l'animation dans le temps",
          "let time = 0;",
          "",
          "// Dimensions de la grille ASCII calculées selon la fenêtre",
          "let cols = Math.floor(window.innerWidth / 7.2);",
          "let rows = Math.floor(window.innerHeight / 12);",
          "",
          "// Mise à jour de la taille de grille lors d'un redimensionnement",
          "window.addEventListener(\"resize\", () => {",
          "  cols = Math.floor(window.innerWidth / 7.2);",
          "  rows = Math.floor(window.innerHeight / 12);",
          "});",
          "",
          "// Fonction qui génère une image ASCII et l'affiche",
          "function updateAsciiAnimation() {",
          "  let frame = \"\";",
          "",
          "  for (let y = 0; y < rows; y++) {",
          "    for (let x = 0; x < cols; x++) {",
          "      // Coordonnées normalisées centrées",
          "      const nx = (x - cols / 2) / 10;",
          "      const ny = (y - rows / 2) / 5;",
          "",
          "      // Calcul d'une onde sinusoïdale complexe",
          "      const dist = Math.sqrt(nx * nx + ny * ny);",
          "      const wave = Math.sin(dist - time) + Math.cos(nx * 2 + time * 0.5);",
          "",
          "      // Normalisation de la valeur entre 0 et 1",
          "      const normalized = (wave + 2) / 4;",
          "      const charIndex = Math.floor(normalized * (chars.length - 1));",
          "      const safeIndex = Math.max(0, Math.min(chars.length - 1, charIndex));",
          "",
          "      frame += chars[safeIndex];",
          "    }",
          "    frame += \"\\n\";",
          "  }",
          "",
          "  asciiDisplay.textContent = frame;",
          "  time += 0.08;",
          "",
          "  requestAnimationFrame(updateAsciiAnimation);",
          "}",
          "",
          "// Lancement de la boucle d'animation",
          "updateAsciiAnimation();"
        ],
        "en": [
          "// Page body setup for fullscreen",
          "document.body.style.margin = \"0\";",
          "document.body.style.padding = \"0\";",
          "document.body.style.backgroundColor = \"#000\";",
          "document.body.style.overflow = \"hidden\";",
          "",
          "// Create the display element for fullscreen ASCII art",
          "const asciiDisplay = document.createElement(\"pre\");",
          "asciiDisplay.style.margin = \"0\";",
          "asciiDisplay.style.padding = \"0\";",
          "asciiDisplay.style.backgroundColor = \"#000\";",
          "asciiDisplay.style.color = \"#00ff66\";",
          "asciiDisplay.style.fontFamily = \"monospace\";",
          "asciiDisplay.style.fontSize = \"12px\";",
          "asciiDisplay.style.lineHeight = \"12px\";",
          "asciiDisplay.style.userSelect = \"none\";",
          "asciiDisplay.style.width = \"100vw\";",
          "asciiDisplay.style.height = \"100vh\";",
          "asciiDisplay.style.display = \"flex\";",
          "asciiDisplay.style.alignItems = \"center\";",
          "asciiDisplay.style.justifyContent = \"center\";",
          "document.body.appendChild(asciiDisplay);",
          "",
          "// Palette composed exclusively of letters and digits, ordered by density",
          "const chars = \"17IiclotTJLOeashkXZ089BNDWM\";",
          "",
          "// Variable to drive the animation over time",
          "let time = 0;",
          "",
          "// Dimensions of the ASCII grid calculated from the window size",
          "let cols = Math.floor(window.innerWidth / 7.2);",
          "let rows = Math.floor(window.innerHeight / 12);",
          "",
          "// Update the grid size on resize",
          "window.addEventListener(\"resize\", () => {",
          "  cols = Math.floor(window.innerWidth / 7.2);",
          "  rows = Math.floor(window.innerHeight / 12);",
          "});",
          "",
          "// Function that generates an ASCII frame and renders it",
          "function updateAsciiAnimation() {",
          "  let frame = \"\";",
          "",
          "  for (let y = 0; y < rows; y++) {",
          "    for (let x = 0; x < cols; x++) {",
          "      // Centered normalized coordinates",
          "      const nx = (x - cols / 2) / 10;",
          "      const ny = (y - rows / 2) / 5;",
          "",
          "      // Compute a complex sine wave",
          "      const dist = Math.sqrt(nx * nx + ny * ny);",
          "      const wave = Math.sin(dist - time) + Math.cos(nx * 2 + time * 0.5);",
          "",
          "      // Normalize value between 0 and 1",
          "      const normalized = (wave + 2) / 4;",
          "      const charIndex = Math.floor(normalized * (chars.length - 1));",
          "      const safeIndex = Math.max(0, Math.min(chars.length - 1, charIndex));",
          "",
          "      frame += chars[safeIndex];",
          "    }",
          "    frame += \"\\n\";",
          "  }",
          "",
          "  asciiDisplay.textContent = frame;",
          "  time += 0.08;",
          "",
          "  requestAnimationFrame(updateAsciiAnimation);",
          "}",
          "",
          "// Start the animation loop",
          "updateAsciiAnimation();"
        ]
      }
    },
    {
      "title": {
        "fr": "Pastel Rainbow Gradient",
        "en": "Pastel Rainbow Gradient"
      },
      "prompt": {
        "fr": "make it infinite expensible wide radial pastel rainbow. make it slow",
        "en": "make it infinite expensible wide radial pastel rainbow. make it slow"
      },
      "code": {
        "fr": [
          "// Configuration d'un dégradé radial pastel infini sur le texte",
          "asciiDisplay.style.webkitBackgroundClip = \"text\";",
          "asciiDisplay.style.webkitTextFillColor = \"transparent\";",
          "asciiDisplay.style.backgroundPosition = \"center center\";",
          "",
          "// Fonction qui génère une image ASCII et anime une onde radiale pastel large, infinie et lente",
          "function updateAsciiAnimation() {",
          "  let frame = \"\";",
          "",
          "  for (let y = 0; y < rows; y++) {",
          "    for (let x = 0; x < cols; x++) {",
          "      // Coordonnées normalisées centrées",
          "      const nx = (x - cols / 2) / 10;",
          "      const ny = (y - rows / 2) / 5;",
          "",
          "      // Calcul d'une onde sinusoïdale complexe",
          "      const dist = Math.sqrt(nx * nx + ny * ny);",
          "      const wave = Math.sin(dist - time) + Math.cos(nx * 2 + time * 0.5);",
          "",
          "      // Normalisation de la valeur entre 0 et 1",
          "      const normalized = (wave + 2) / 4;",
          "      const charIndex = Math.floor(normalized * (chars.length - 1));",
          "      const safeIndex = Math.max(0, Math.min(chars.length - 1, charIndex));",
          "",
          "      frame += chars[safeIndex];",
          "    }",
          "    frame += \"\\n\";",
          "  }",
          "",
          "  asciiDisplay.textContent = frame;",
          "",
          "  // Anneaux très larges en couleurs pastel qui s'étendent lentement vers l'extérieur",
          "  const ringPeriod = 600;",
          "  const offset = (time * 10) % ringPeriod;",
          "  asciiDisplay.style.backgroundImage = `repeating-radial-gradient(circle at center,",
          "    #ffb3ba ${offset}px,",
          "    #ffdfba ${offset + ringPeriod * (1 / 6)}px,",
          "    #ffffba ${offset + ringPeriod * (2 / 6)}px,",
          "    #baffc9 ${offset + ringPeriod * (3 / 6)}px,",
          "    #bae1ff ${offset + ringPeriod * (4 / 6)}px,",
          "    #e8baff ${offset + ringPeriod * (5 / 6)}px,",
          "    #ffb3ba ${offset + ringPeriod}px",
          "  )`;",
          "",
          "  // Progression lente de l'animation globale",
          "  time += 0.015;",
          "",
          "  requestAnimationFrame(updateAsciiAnimation);",
          "}"
        ],
        "en": [
          "// Set up an infinite pastel radial gradient on the text",
          "asciiDisplay.style.webkitBackgroundClip = \"text\";",
          "asciiDisplay.style.webkitTextFillColor = \"transparent\";",
          "asciiDisplay.style.backgroundPosition = \"center center\";",
          "",
          "// Function that generates an ASCII frame and animates a wide, infinite, slow pastel radial wave",
          "function updateAsciiAnimation() {",
          "  let frame = \"\";",
          "",
          "  for (let y = 0; y < rows; y++) {",
          "    for (let x = 0; x < cols; x++) {",
          "      // Centered normalized coordinates",
          "      const nx = (x - cols / 2) / 10;",
          "      const ny = (y - rows / 2) / 5;",
          "",
          "      // Compute a complex sine wave",
          "      const dist = Math.sqrt(nx * nx + ny * ny);",
          "      const wave = Math.sin(dist - time) + Math.cos(nx * 2 + time * 0.5);",
          "",
          "      // Normalize value between 0 and 1",
          "      const normalized = (wave + 2) / 4;",
          "      const charIndex = Math.floor(normalized * (chars.length - 1));",
          "      const safeIndex = Math.max(0, Math.min(chars.length - 1, charIndex));",
          "",
          "      frame += chars[safeIndex];",
          "    }",
          "    frame += \"\\n\";",
          "  }",
          "",
          "  asciiDisplay.textContent = frame;",
          "",
          "  // Very wide pastel-colored rings expanding slowly outward",
          "  const ringPeriod = 600;",
          "  const offset = (time * 10) % ringPeriod;",
          "  asciiDisplay.style.backgroundImage = `repeating-radial-gradient(circle at center,",
          "    #ffb3ba ${offset}px,",
          "    #ffdfba ${offset + ringPeriod * (1 / 6)}px,",
          "    #ffffba ${offset + ringPeriod * (2 / 6)}px,",
          "    #baffc9 ${offset + ringPeriod * (3 / 6)}px,",
          "    #bae1ff ${offset + ringPeriod * (4 / 6)}px,",
          "    #e8baff ${offset + ringPeriod * (5 / 6)}px,",
          "    #ffb3ba ${offset + ringPeriod}px",
          "  )`;",
          "",
          "  // Slow progression of the overall animation",
          "  time += 0.015;",
          "",
          "  requestAnimationFrame(updateAsciiAnimation);",
          "}"
        ]
      }
    }
  ]
}
