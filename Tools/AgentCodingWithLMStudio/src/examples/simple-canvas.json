{
  "title": {
    "fr": "Simple canvas",
    "en": "Simple canvas"
  },
  "mode": "vanilla",
  "steps": [
    {
      "title": {
        "fr": "Créer un canvas plein écran",
        "en": "Fullscreen Canvas Setup"
      },
      "prompt": {
        "fr": "Créer un canvas plein écran avec un fond bleu clair",
        "en": "Create a fullscreen canvas with a light blue background"
      },
      "code": {
        "fr": [
          "// Création et ajout du canvas dans la page",
          "const canvas = document.createElement('canvas');",
          "document.body.style.margin = '0';",
          "document.body.style.overflow = 'hidden';",
          "document.body.appendChild(canvas);",
          "",
          "const ctx = canvas.getContext('2d');",
          "",
          "// Ajustement de la taille du canvas à la fenêtre",
          "function resizeCanvas() {",
          "  canvas.width = window.innerWidth;",
          "  canvas.height = window.innerHeight;",
          "}",
          "",
          "window.addEventListener('resize', resizeCanvas);",
          "resizeCanvas();",
          "",
          "// Fonction pour dessiner le fond bleu clair",
          "function drawBackground() {",
          "  ctx.fillStyle = 'lightblue';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "}",
          "",
          "// Fonction principale de dessin",
          "function draw() {",
          "  drawBackground();",
          "}",
          "",
          "// Boucle d'animation",
          "function loop() {",
          "  draw();",
          "  requestAnimationFrame(loop);",
          "}",
          "",
          "loop();"
        ],
        "en": [
          "// Creating and adding the canvas to the page",
          "const canvas = document.createElement('canvas');",
          "document.body.style.margin = '0';",
          "document.body.style.overflow = 'hidden';",
          "document.body.appendChild(canvas);",
          "",
          "const ctx = canvas.getContext('2d');",
          "",
          "// Resizing the canvas to fit the window",
          "function resizeCanvas() {",
          "  canvas.width = window.innerWidth;",
          "  canvas.height = window.innerHeight;",
          "}",
          "",
          "window.addEventListener('resize', resizeCanvas);",
          "resizeCanvas();",
          "",
          "// Function to draw the light blue background",
          "function drawBackground() {",
          "  ctx.fillStyle = 'lightblue';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "}",
          "",
          "// Main drawing function",
          "function draw() {",
          "  drawBackground();",
          "}",
          "",
          "// Animation loop",
          "function loop() {",
          "  draw();",
          "  requestAnimationFrame(loop);",
          "}",
          "",
          "loop();"
        ]
      }
    }
  ]
}
