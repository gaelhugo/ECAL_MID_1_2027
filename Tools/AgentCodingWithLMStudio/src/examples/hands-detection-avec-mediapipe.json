{
  "title": {
    "fr": "hands detection avec MediaPipe",
    "en": "Hand Detection with MediaPipe"
  },
  "mode": "vanilla",
  "steps": [
    {
      "title": {
        "fr": "Fullscreen Canvas Setup",
        "en": "Fullscreen Canvas Setup"
      },
      "prompt": {
        "fr": "Creer un canvas fullscreen",
        "en": "Create a fullscreen canvas"
      },
      "code": {
        "fr": [
          "// Création et insertion du canvas dans le document",
          "const canvas = document.createElement('canvas');",
          "const ctx = canvas.getContext('2d');",
          "document.body.appendChild(canvas);",
          "",
          "// Application des styles pour occuper tout l'écran sans marges",
          "document.body.style.margin = '0';",
          "document.body.style.overflow = 'hidden';",
          "canvas.style.position = 'fixed';",
          "canvas.style.top = '0';",
          "canvas.style.left = '0';",
          "canvas.style.display = 'block';",
          "",
          "// Fonction pour redimensionner le canvas à la taille de la fenêtre",
          "function resizeCanvas() {",
          "  canvas.width = window.innerWidth;",
          "  canvas.height = window.innerHeight;",
          "}",
          "",
          "// Redimensionnement initial et écoute des changements de taille",
          "resizeCanvas();",
          "window.addEventListener('resize', resizeCanvas);",
          "",
          "// Fonction de dessin principal",
          "function draw() {",
          "  ctx.fillStyle = '#cccccc';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "}",
          "",
          "// Boucle d'animation",
          "function loop() {",
          "  draw();",
          "  requestAnimationFrame(loop);",
          "}",
          "",
          "loop();"
        ],
        "en": [
          "// Creation and insertion of the canvas into the document",
          "const canvas = document.createElement('canvas');",
          "const ctx = canvas.getContext('2d');",
          "document.body.appendChild(canvas);",
          "",
          "// Application of styles to occupy the entire screen without margins",
          "document.body.style.margin = '0';",
          "document.body.style.overflow = 'hidden';",
          "canvas.style.position = 'fixed';",
          "canvas.style.top = '0';",
          "canvas.style.left = '0';",
          "canvas.style.display = 'block';",
          "",
          "// Function to resize the canvas to the window size",
          "function resizeCanvas() {",
          "  canvas.width = window.innerWidth;",
          "  canvas.height = window.innerHeight;",
          "}",
          "",
          "// Initial resizing and listening for size changes",
          "resizeCanvas();",
          "window.addEventListener('resize', resizeCanvas);",
          "",
          "// Main drawing function",
          "function draw() {",
          "  ctx.fillStyle = '#cccccc';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "}",
          "",
          "// Animation loop",
          "function loop() {",
          "  draw();",
          "  requestAnimationFrame(loop);",
          "}",
          "",
          "loop();"
        ]
      }
    },
    {
      "title": {
        "fr": "Camera Stream Capture",
        "en": "Camera Stream Capture"
      },
      "prompt": {
        "fr": "Activer la camera, et récupérer le flux sans le montrer à l'écran.",
        "en": "Activate the camera and retrieve the stream without displaying it on screen."
      },
      "code": {
        "fr": [
          "// Création d'un élément vidéo invisible pour recevoir le flux de la caméra",
          "const video = document.createElement('video');",
          "video.autoplay = true;",
          "video.playsInline = true;",
          "",
          "// Demande d'accès à la webcam et association du flux à la vidéo",
          "navigator.mediaDevices.getUserMedia({ video: true, audio: false })",
          "  .then((stream) => {",
          "    video.srcObject = stream;",
          "  })",
          "  .catch((err) => {",
          "    console.error('Erreur lors de l\\'accès à la caméra :', err);",
          "  });"
        ],
        "en": [
          "// Creation of an invisible video element to receive the camera stream",
          "const video = document.createElement('video');",
          "video.autoplay = true;",
          "video.playsInline = true;",
          "",
          "// Request access to the webcam and associate the stream with the video",
          "navigator.mediaDevices.getUserMedia({ video: true, audio: false })",
          "  .then((stream) => {",
          "    video.srcObject = stream;",
          "  })",
          "  .catch((err) => {",
          "    console.error('Error accessing the camera:', err);",
          "  });"
        ]
      }
    },
    {
      "title": {
        "fr": "Load MediaPipe Hands",
        "en": "Load MediaPipe Hands"
      },
      "prompt": {
        "fr": "Charger la librarie MediaPipe  pour la detection des mains .",
        "en": "Load the MediaPipe library for hand detection."
      },
      "code": {
        "fr": [
          "// Chargement du script MediaPipe Hands via une balise script dynamique",
          "const mpScript = document.createElement('script');",
          "mpScript.src = 'https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js';",
          "mpScript.crossOrigin = 'anonymous';",
          "document.head.appendChild(mpScript);",
          "",
          "// Variable globale pour stocker l'instance de détection des mains",
          "let handsDetector = null;",
          "",
          "// Initialisation de MediaPipe une fois le script chargé",
          "mpScript.onload = () => {",
          "  handsDetector = new Hands({",
          "    locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`",
          "  });",
          "",
          "  handsDetector.setOptions({",
          "    maxNumHands: 2,",
          "    modelComplexity: 1,",
          "    minDetectionConfidence: 0.5,",
          "    minTrackingConfidence: 0.5",
          "  });",
          "",
          "  console.log('Bibliothèque MediaPipe Hands chargée avec succès.');",
          "};"
        ],
        "en": [
          "// Loading the MediaPipe Hands script via a dynamic script tag",
          "const mpScript = document.createElement('script');",
          "mpScript.src = 'https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js';",
          "mpScript.crossOrigin = 'anonymous';",
          "document.head.appendChild(mpScript);",
          "",
          "// Global variable to store the hand detection instance",
          "let handsDetector = null;",
          "",
          "// Initialization of MediaPipe once the script is loaded",
          "mpScript.onload = () => {",
          "  handsDetector = new Hands({",
          "    locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`",
          "  });",
          "",
          "  handsDetector.setOptions({",
          "    maxNumHands: 2,",
          "    modelComplexity: 1,",
          "    minDetectionConfidence: 0.5,",
          "    minTrackingConfidence: 0.5",
          "  });",
          "",
          "  console.log('MediaPipe Hands library loaded successfully.');",
          "};"
        ]
      }
    },
    {
      "title": {
        "fr": "Mirrored Hand Skeleton",
        "en": "Mirrored Hand Skeleton"
      },
      "prompt": {
        "fr": "Détecter les main et afficher le skeleton en mode mirroir",
        "en": "Detect hands and display the skeleton in mirrored mode."
      },
      "code": {
        "fr": [
          "// Connexions standard des articulations de la main dans MediaPipe",
          "const handConnections = [",
          "  [0, 1], [1, 2], [2, 3], [3, 4],       // Pouce",
          "  [0, 5], [5, 6], [6, 7], [7, 8],       // Index",
          "  [5, 9], [9, 10], [10, 11], [11, 12],  // Majeur",
          "  [9, 13], [13, 14], [14, 15], [15, 16],// Annulaire",
          "  [13, 17], [17, 18], [18, 19], [19, 20],// Auriculaire",
          "  [0, 17]                               // Paume",
          "];",
          "",
          "// Variable globale pour stocker les derniers résultats de détection",
          "let detectedHands = [];",
          "",
          "// Fonction pour configurer l'écouteur de résultats sur le détecteur",
          "function setupHandsResults() {",
          "  if (handsDetector) {",
          "    handsDetector.onResults((results) => {",
          "      detectedHands = results.multiHandLandmarks || [];",
          "    });",
          "  }",
          "}",
          "",
          "// Vérification de la disponibilité du détecteur pour attacher le rappel",
          "if (handsDetector) {",
          "  setupHandsResults();",
          "} else {",
          "  const originalOnload = mpScript.onload;",
          "  mpScript.onload = () => {",
          "    if (originalOnload) originalOnload();",
          "    setupHandsResults();",
          "  };",
          "}",
          "",
          "// Indicateur pour éviter d'envoyer une nouvelle image avant la fin du traitement",
          "let isProcessingFrame = false;",
          "",
          "// Dessin du squelette d'une main en inversant horizontalement la coordonnée X pour l'effet miroir",
          "function drawHandSkeleton(landmarks) {",
          "  // Dessin des segments osseux",
          "  ctx.strokeStyle = '#ffffff';",
          "  ctx.lineWidth = 3;",
          "  for (const [startIdx, endIdx] of handConnections) {",
          "    const p1 = landmarks[startIdx];",
          "    const p2 = landmarks[endIdx];",
          "    ctx.beginPath();",
          "    ctx.moveTo((1 - p1.x) * canvas.width, p1.y * canvas.height);",
          "    ctx.lineTo((1 - p2.x) * canvas.width, p2.y * canvas.height);",
          "    ctx.stroke();",
          "  }",
          "",
          "  // Dessin des articulations (points)",
          "  ctx.fillStyle = '#ff0055';",
          "  for (const point of landmarks) {",
          "    ctx.beginPath();",
          "    ctx.arc((1 - point.x) * canvas.width, point.y * canvas.height, 5, 0, Math.PI * 2);",
          "    ctx.fill();",
          "  }",
          "}",
          "",
          "// Redéfinition de la fonction de dessin pour inclure l'analyse et le squelette en miroir",
          "function draw() {",
          "  // Fond gris neutre",
          "  ctx.fillStyle = '#222222';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "",
          "  // Envoi de la trame vidéo au modèle de détection si disponible",
          "  if (handsDetector && video.readyState >= 2 && !isProcessingFrame) {",
          "    isProcessingFrame = true;",
          "    handsDetector.send({ image: video }).then(() => {",
          "      isProcessingFrame = false;",
          "    }).catch(() => {",
          "      isProcessingFrame = false;",
          "    });",
          "  }",
          "",
          "  // Affichage du squelette pour chaque main détectée",
          "  for (const landmarks of detectedHands) {",
          "    drawHandSkeleton(landmarks);",
          "  }",
          "}"
        ],
        "en": [
          "// Standard connections of hand joints in MediaPipe",
          "const handConnections = [",
          "  [0, 1], [1, 2], [2, 3], [3, 4],       // Thumb",
          "  [0, 5], [5, 6], [6, 7], [7, 8],       // Index finger",
          "  [5, 9], [9, 10], [10, 11], [11, 12],  // Middle finger",
          "  [9, 13], [13, 14], [14, 15], [15, 16],// Ring finger",
          "  [13, 17], [17, 18], [18, 19], [19, 20],// Little finger",
          "  [0, 17]                               // Palm",
          "];",
          "",
          "// Global variable to store the latest detection results",
          "let detectedHands = [];",
          "",
          "// Function to set up the result listener on the detector",
          "function setupHandsResults() {",
          "  if (handsDetector) {",
          "    handsDetector.onResults((results) => {",
          "      detectedHands = results.multiHandLandmarks || [];",
          "    });",
          "  }",
          "}",
          "",
          "// Check if the detector is available to attach the callback",
          "if (handsDetector) {",
          "  setupHandsResults();",
          "} else {",
          "  const originalOnload = mpScript.onload;",
          "  mpScript.onload = () => {",
          "    if (originalOnload) originalOnload();",
          "    setupHandsResults();",
          "  };",
          "}",
          "",
          "// Indicator to avoid sending a new frame before processing is complete",
          "let isProcessingFrame = false;",
          "",
          "// Drawing the hand skeleton by horizontally inverting the X coordinate for the mirror effect",
          "function drawHandSkeleton(landmarks) {",
          "  // Drawing bone segments",
          "  ctx.strokeStyle = '#ffffff';",
          "  ctx.lineWidth = 3;",
          "  for (const [startIdx, endIdx] of handConnections) {",
          "    const p1 = landmarks[startIdx];",
          "    const p2 = landmarks[endIdx];",
          "    ctx.beginPath();",
          "    ctx.moveTo((1 - p1.x) * canvas.width, p1.y * canvas.height);",
          "    ctx.lineTo((1 - p2.x) * canvas.width, p2.y * canvas.height);",
          "    ctx.stroke();",
          "  }",
          "",
          "  // Drawing joints (points)",
          "  ctx.fillStyle = '#ff0055';",
          "  for (const point of landmarks) {",
          "    ctx.beginPath();",
          "    ctx.arc((1 - point.x) * canvas.width, point.y * canvas.height, 5, 0, Math.PI * 2);",
          "    ctx.fill();",
          "  }",
          "}",
          "",
          "// Redefinition of the draw function to include analysis and mirrored skeleton",
          "function draw() {",
          "  // Neutral gray background",
          "  ctx.fillStyle = '#222222';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "",
          "  // Sending the video frame to the detection model if available",
          "  if (handsDetector && video.readyState >= 2 && !isProcessingFrame) {",
          "    isProcessingFrame = true;",
          "    handsDetector.send({ image: video }).then(() => {",
          "      isProcessingFrame = false;",
          "    }).catch(() => {",
          "      isProcessingFrame = false;",
          "    });",
          "  }",
          "",
          "  // Displaying the skeleton for each detected hand",
          "  for (const landmarks of detectedHands) {",
          "    drawHandSkeleton(landmarks);",
          "  }",
          "}"
        ]
      }
    },
    {
      "title": {
        "fr": "Foreground Grid with Sound",
        "en": "Foreground Grid with Sound"
      },
      "prompt": {
        "fr": "créer une grille au premier plan, où chaque case peut être activée si l'index (id = 8 ) est à l'interieur de la case. En même temps de l'activation visuelle, j'aimerais un son à fréquence differente pour chaque case",
        "en": "Create a grid in the foreground where each cell can be activated if the index finger (id = 8) is inside it. At the same time, I would like a different sound at a different frequency for each cell."
      },
      "code": {
        "fr": [
          "// Initialisation du contexte audio pour la synthèse sonore",
          "let audioCtx = null;",
          "",
          "// Initialisation au premier geste utilisateur ou premier déclenchement",
          "function initAudio() {",
          "  if (!audioCtx) {",
          "    audioCtx = new (window.AudioContext || window.webkitAudioContext)();",
          "  }",
          "  if (audioCtx.state === 'suspended') {",
          "    audioCtx.resume();",
          "  }",
          "}",
          "",
          "// Fonction pour jouer une note brève à une fréquence donnée",
          "function playNote(freq) {",
          "  initAudio();",
          "  if (!audioCtx) return;",
          "",
          "  const osc = audioCtx.createOscillator();",
          "  const gain = audioCtx.createGain();",
          "",
          "  osc.type = 'sine';",
          "  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);",
          "",
          "  // Enveloppe sonore rapide",
          "  gain.gain.setValueAtTime(0.2, audioCtx.currentTime);",
          "  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);",
          "",
          "  osc.connect(gain);",
          "  gain.connect(audioCtx.destination);",
          "",
          "  osc.start();",
          "  osc.stop(audioCtx.currentTime + 0.3);",
          "}",
          "",
          "// Définition de la grille",
          "const gridCols = 4;",
          "const gridRows = 3;",
          "",
          "// Fréquences pour chaque case de la grille (gamme pentatonique majeure)",
          "const baseFrequencies = [",
          "  261.63, 293.66, 329.63, 392.00,",
          "  440.00, 523.25, 587.33, 659.25,",
          "  783.99, 880.00, 1046.50, 1174.66",
          "];",
          "",
          "// État d'activation précédent de chaque case pour détecter les nouvelles activations",
          "const cellActiveState = new Array(gridCols * gridRows).fill(false);",
          "",
          "// Dessin de la grille et gestion des activations sonores et visuelles",
          "function drawGrid(indexFingerPoints) {",
          "  const cellWidth = canvas.width / gridCols;",
          "  const cellHeight = canvas.height / gridRows;",
          "",
          "  for (let r = 0; r < gridRows; r++) {",
          "    for (let c = 0; c < gridCols; c++) {",
          "      const idx = r * gridCols + c;",
          "      const x = c * cellWidth;",
          "      const y = r * cellHeight;",
          "",
          "      // Vérification si au moins un index se trouve dans cette case",
          "      const isInside = indexFingerPoints.some((p) => (",
          "        p.x >= x && p.x < x + cellWidth && p.y >= y && p.y < y + cellHeight",
          "      ));",
          "",
          "      // Déclenchement du son si la case vient d'être activée",
          "      if (isInside && !cellActiveState[idx]) {",
          "        playNote(baseFrequencies[idx % baseFrequencies.length]);",
          "      }",
          "      cellActiveState[idx] = isInside;",
          "",
          "      // Affichage de la case : couleur de fond si activée",
          "      if (isInside) {",
          "        ctx.fillStyle = 'rgba(0, 255, 180, 0.35)';",
          "        ctx.fillRect(x, y, cellWidth, cellHeight);",
          "      }",
          "",
          "      // Bordure de la case",
          "      ctx.strokeStyle = isInside ? '#00ffb4' : 'rgba(255, 255, 255, 0.2)';",
          "      ctx.lineWidth = isInside ? 3 : 1;",
          "      ctx.strokeRect(x, y, cellWidth, cellHeight);",
          "    }",
          "  }",
          "}",
          "",
          "// Redéfinition de la fonction de dessin pour inclure la détection de l'index et la grille",
          "function draw() {",
          "  // Fond gris neutre",
          "  ctx.fillStyle = '#222222';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "",
          "  // Envoi de la trame vidéo au modèle de détection si disponible",
          "  if (handsDetector && video.readyState >= 2 && !isProcessingFrame) {",
          "    isProcessingFrame = true;",
          "    handsDetector.send({ image: video }).then(() => {",
          "      isProcessingFrame = false;",
          "    }).catch(() => {",
          "      isProcessingFrame = false;",
          "    });",
          "  }",
          "",
          "  // Liste des positions de chaque index détecté (point 8) en coordonnées miroir",
          "  const indexPoints = [];",
          "",
          "  // Affichage du squelette pour chaque main détectée",
          "  for (const landmarks of detectedHands) {",
          "    drawHandSkeleton(landmarks);",
          "",
          "    // Récupération de l'extrémité de l'index (id = 8)",
          "    const tip = landmarks[8];",
          "    if (tip) {",
          "      indexPoints.push({",
          "        x: (1 - tip.x) * canvas.width,",
          "        y: tip.y * canvas.height",
          "      });",
          "    }",
          "  }",
          "",
          "  // Dessin de la grille interactive au premier plan",
          "  drawGrid(indexPoints);",
          "}"
        ],
        "en": [
          "// Initialization of audio context for sound synthesis",
          "let audioCtx = null;",
          "",
          "// Initialization on first user gesture or first trigger",
          "function initAudio() {",
          "  if (!audioCtx) {",
          "    audioCtx = new (window.AudioContext || window.webkitAudioContext)();",
          "  }",
          "  if (audioCtx.state === 'suspended') {",
          "    audioCtx.resume();",
          "  }",
          "}",
          "",
          "// Function to play a brief note at a given frequency",
          "function playNote(freq) {",
          "  initAudio();",
          "  if (!audioCtx) return;",
          "",
          "  const osc = audioCtx.createOscillator();",
          "  const gain = audioCtx.createGain();",
          "",
          "  osc.type = 'sine';",
          "  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);",
          "",
          "  // Fast sound envelope",
          "  gain.gain.setValueAtTime(0.2, audioCtx.currentTime);",
          "  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);",
          "",
          "  osc.connect(gain);",
          "  gain.connect(audioCtx.destination);",
          "",
          "  osc.start();",
          "  osc.stop(audioCtx.currentTime + 0.3);",
          "}",
          "",
          "// Definition of the grid",
          "const gridCols = 4;",
          "const gridRows = 3;",
          "",
          "// Frequencies for each cell in the grid (major pentatonic scale)",
          "const baseFrequencies = [",
          "  261.63, 293.66, 329.63, 392.00,",
          "  440.00, 523.25, 587.33, 659.25,",
          "  783.99, 880.00, 1046.50, 1174.66",
          "];",
          "",
          "// Previous activation state of each cell to detect new activations",
          "const cellActiveState = new Array(gridCols * gridRows).fill(false);",
          "",
          "// Drawing the grid and managing sound and visual activations",
          "function drawGrid(indexFingerPoints) {",
          "  const cellWidth = canvas.width / gridCols;",
          "  const cellHeight = canvas.height / gridRows;",
          "",
          "  for (let r = 0; r < gridRows; r++) {",
          "    for (let c = 0; c < gridCols; c++) {",
          "      const idx = r * gridCols + c;",
          "      const x = c * cellWidth;",
          "      const y = r * cellHeight;",
          "",
          "      // Check if at least one index is inside this cell",
          "      const isInside = indexFingerPoints.some((p) => (",
          "        p.x >= x && p.x < x + cellWidth && p.y >= y && p.y < y + cellHeight",
          "      ));",
          "",
          "      // Sound trigger if the cell has just been activated",
          "      if (isInside && !cellActiveState[idx]) {",
          "        playNote(baseFrequencies[idx % baseFrequencies.length]);",
          "      }",
          "      cellActiveState[idx] = isInside;",
          "",
          "      // Display of the cell: background color if active",
          "      if (isInside) {",
          "        ctx.fillStyle = 'rgba(0, 255, 180, 0.35)';",
          "        ctx.fillRect(x, y, cellWidth, cellHeight);",
          "      }",
          "",
          "      // Cell border",
          "      ctx.strokeStyle = isInside ? '#00ffb4' : 'rgba(255, 255, 255, 0.2)';",
          "      ctx.lineWidth = isInside ? 3 : 1;",
          "      ctx.strokeRect(x, y, cellWidth, cellHeight);",
          "    }",
          "  }",
          "}",
          "",
          "// Redefinition of the draw function to include index detection and grid",
          "function draw() {",
          "  // Neutral gray background",
          "  ctx.fillStyle = '#222222';",
          "  ctx.fillRect(0, 0, canvas.width, canvas.height);",
          "",
          "  // Sending the video frame to the detection model if available",
          "  if (handsDetector && video.readyState >= 2 && !isProcessingFrame) {",
          "    isProcessingFrame = true;",
          "    handsDetector.send({ image: video }).then(() => {",
          "      isProcessingFrame = false;",
          "    }).catch(() => {",
          "      isProcessingFrame = false;",
          "    });",
          "  }",
          "",
          "  // List of positions of each detected index (point 8) in mirrored coordinates",
          "  const indexPoints = [];",
          "",
          "  // Displaying the skeleton for each detected hand",
          "  for (const landmarks of detectedHands) {",
          "    drawHandSkeleton(landmarks);",
          "",
          "    // Retrieving the tip of the index finger (id = 8)",
          "    const tip = landmarks[8];",
          "    if (tip) {",
          "      indexPoints.push({",
          "        x: (1 - tip.x) * canvas.width,",
          "        y: tip.y * canvas.height",
          "      });",
          "    }",
          "  }",
          "",
          "  // Drawing the interactive grid in the foreground",
          "  drawGrid(indexPoints);",
          "}"
        ]
      }
    }
  ]
}
