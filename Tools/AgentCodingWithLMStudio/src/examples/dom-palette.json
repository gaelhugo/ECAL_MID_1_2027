{
  "title": {
    "fr": "Palette de couleurs",
    "en": "Color palette"
  },
  "mode": "dom",
  "steps": [
    {
      "title": {
        "fr": "Titre et texte",
        "en": "Title and text"
      },
      "prompt": {
        "fr": "Crée l'en-tête de la page avec un grand titre « Palette » et une courte phrase d'introduction, avec une mise en page aérée.",
        "en": "Create the page header with a big “Palette” title and a short introduction sentence, with an airy layout."
      },
      "code": {
        "fr": [
          "// L'en-tête de la page : un titre et une phrase d'introduction",
          "const header = document.createElement(\"header\");",
          "header.innerHTML = `",
          "  <h1>Palette</h1>",
          "  <p>Une collection de couleurs, construite pas à pas avec le DOM.</p>",
          "`;",
          "document.body.append(header);",
          "",
          "// Styles de base : marges aérées, titre très grand",
          "css(`",
          "  body { padding: 48px; }",
          "  header h1 { font-size: 56px; margin: 0; letter-spacing: -0.02em; }",
          "  header p { color: #5f6368; font-size: 18px; margin: 8px 0 32px; }",
          "`);"
        ],
        "en": [
          "// The page header: a title and an introduction sentence",
          "const header = document.createElement(\"header\");",
          "header.innerHTML = `",
          "  <h1>Palette</h1>",
          "  <p>A collection of colors, built step by step with the DOM.</p>",
          "`;",
          "document.body.append(header);",
          "",
          "// Base styles: airy margins, very big title",
          "css(`",
          "  body { padding: 48px; }",
          "  header h1 { font-size: 56px; margin: 0; letter-spacing: -0.02em; }",
          "  header p { color: #5f6368; font-size: 18px; margin: 8px 0 32px; }",
          "`);"
        ]
      }
    },
    {
      "title": {
        "fr": "Afficher des cartes",
        "en": "Show cards"
      },
      "prompt": {
        "fr": "Affiche une grille de cartes, une par couleur d'une liste de 8 couleurs nommées : chaque carte montre un aplat de la couleur, son nom et son code hexadécimal.",
        "en": "Show a grid of cards, one per color from a list of 8 named colors: each card shows a swatch of the color, its name and its hex code."
      },
      "code": {
        "fr": [
          "// Les couleurs de la palette",
          "const palette = [",
          "  { name: \"Citron\", hex: \"#ffd60a\" },",
          "  { name: \"Tomate\", hex: \"#ff6b4a\" },",
          "  { name: \"Framboise\", hex: \"#e63977\" },",
          "  { name: \"Lavande\", hex: \"#9b8cff\" },",
          "  { name: \"Océan\", hex: \"#1f8bff\" },",
          "  { name: \"Menthe\", hex: \"#2ec4a6\" },",
          "  { name: \"Sapin\", hex: \"#1b6b4f\" },",
          "  { name: \"Encre\", hex: \"#202124\" },",
          "];",
          "",
          "// La grille qui contient les cartes",
          "const grid = document.createElement(\"main\");",
          "grid.className = \"grid\";",
          "document.body.append(grid);",
          "",
          "// Une carte : aplat de couleur, nom et code",
          "function createCard(color) {",
          "  const card = document.createElement(\"article\");",
          "  card.className = \"card\";",
          "  card.innerHTML = `",
          "    <div class=\"swatch\" style=\"background: ${color.hex}\"></div>",
          "    <strong>${color.name}</strong>",
          "    <code>${color.hex}</code>",
          "  `;",
          "  return card;",
          "}",
          "",
          "// Reconstruit la grille à partir des données (cette fonction va évoluer)",
          "function render() {",
          "  grid.replaceChildren(...palette.map(createCard));",
          "}",
          "render();",
          "",
          "css(`",
          "  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }",
          "  .card { display: flex; flex-direction: column; gap: 4px; padding: 12px; border-radius: 16px; background: #f1f3f4; }",
          "  .swatch { height: 100px; border-radius: 10px; margin-bottom: 8px; }",
          "  .card code { color: #5f6368; font-size: 13px; }",
          "`);"
        ],
        "en": [
          "// The palette colors",
          "const palette = [",
          "  { name: \"Lemon\", hex: \"#ffd60a\" },",
          "  { name: \"Tomato\", hex: \"#ff6b4a\" },",
          "  { name: \"Raspberry\", hex: \"#e63977\" },",
          "  { name: \"Lavender\", hex: \"#9b8cff\" },",
          "  { name: \"Ocean\", hex: \"#1f8bff\" },",
          "  { name: \"Mint\", hex: \"#2ec4a6\" },",
          "  { name: \"Pine\", hex: \"#1b6b4f\" },",
          "  { name: \"Ink\", hex: \"#202124\" },",
          "];",
          "",
          "// The grid that holds the cards",
          "const grid = document.createElement(\"main\");",
          "grid.className = \"grid\";",
          "document.body.append(grid);",
          "",
          "// A card: color swatch, name and code",
          "function createCard(color) {",
          "  const card = document.createElement(\"article\");",
          "  card.className = \"card\";",
          "  card.innerHTML = `",
          "    <div class=\"swatch\" style=\"background: ${color.hex}\"></div>",
          "    <strong>${color.name}</strong>",
          "    <code>${color.hex}</code>",
          "  `;",
          "  return card;",
          "}",
          "",
          "// Rebuilds the grid from the data (this function will evolve)",
          "function render() {",
          "  grid.replaceChildren(...palette.map(createCard));",
          "}",
          "render();",
          "",
          "css(`",
          "  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }",
          "  .card { display: flex; flex-direction: column; gap: 4px; padding: 12px; border-radius: 16px; background: #f1f3f4; }",
          "  .swatch { height: 100px; border-radius: 10px; margin-bottom: 8px; }",
          "  .card code { color: #5f6368; font-size: 13px; }",
          "`);"
        ]
      }
    },
    {
      "title": {
        "fr": "Filtrer par nom",
        "en": "Filter by name"
      },
      "prompt": {
        "fr": "Ajoute un champ de recherche sous le titre : en tapant, seules les couleurs dont le nom contient le texte restent affichées.",
        "en": "Add a search field under the title: while typing, only the colors whose name contains the text stay visible."
      },
      "code": {
        "fr": [
          "// Le texte recherché (état de la page)",
          "let query = \"\";",
          "",
          "// Un champ de recherche, ajouté dans l'en-tête",
          "const search = document.createElement(\"input\");",
          "search.type = \"search\";",
          "search.placeholder = \"Rechercher une couleur…\";",
          "header.append(search);",
          "",
          "// À chaque frappe : on met à jour l'état, puis on reconstruit la grille",
          "search.addEventListener(\"input\", () => {",
          "  query = search.value.trim().toLowerCase();",
          "  render();",
          "});",
          "",
          "// On redéfinit render() : seules les couleurs correspondantes sont affichées",
          "function render() {",
          "  const visible = palette.filter((color) => color.name.toLowerCase().includes(query));",
          "  grid.replaceChildren(...visible.map(createCard));",
          "}",
          "",
          "css(`",
          "  header input { font: inherit; padding: 10px 16px; border: 1px solid #dadce0; border-radius: 999px; width: 260px; margin-bottom: 32px; }",
          "`);"
        ],
        "en": [
          "// The searched text (page state)",
          "let query = \"\";",
          "",
          "// A search field, added to the header",
          "const search = document.createElement(\"input\");",
          "search.type = \"search\";",
          "search.placeholder = \"Search a color…\";",
          "header.append(search);",
          "",
          "// On each keystroke: update the state, then rebuild the grid",
          "search.addEventListener(\"input\", () => {",
          "  query = search.value.trim().toLowerCase();",
          "  render();",
          "});",
          "",
          "// We redefine render(): only the matching colors are shown",
          "function render() {",
          "  const visible = palette.filter((color) => color.name.toLowerCase().includes(query));",
          "  grid.replaceChildren(...visible.map(createCard));",
          "}",
          "",
          "css(`",
          "  header input { font: inherit; padding: 10px 16px; border: 1px solid #dadce0; border-radius: 999px; width: 260px; margin-bottom: 32px; }",
          "`);"
        ]
      }
    },
    {
      "title": {
        "fr": "Choisir une couleur",
        "en": "Pick a color"
      },
      "prompt": {
        "fr": "Quand on clique sur une carte, elle est mise en avant (bordure épaisse) et sa couleur devient la couleur du titre.",
        "en": "When a card is clicked, it is highlighted (thick border) and its color becomes the title color."
      },
      "code": {
        "fr": [
          "// La couleur choisie (aucune au départ)",
          "let selected = null;",
          "",
          "// On redéfinit createCard() : un clic choisit la couleur",
          "function createCard(color) {",
          "  const card = document.createElement(\"article\");",
          "  card.className = \"card\";",
          "  card.classList.toggle(\"is-selected\", color === selected);",
          "  card.innerHTML = `",
          "    <div class=\"swatch\" style=\"background: ${color.hex}\"></div>",
          "    <strong>${color.name}</strong>",
          "    <code>${color.hex}</code>",
          "  `;",
          "  card.addEventListener(\"click\", () => {",
          "    selected = color;",
          "    header.querySelector(\"h1\").style.color = color.hex;",
          "    render();",
          "  });",
          "  return card;",
          "}",
          "render();",
          "",
          "css(`",
          "  .card { cursor: pointer; border: 3px solid transparent; transition: transform 0.15s; }",
          "  .card:hover { transform: translateY(-3px); }",
          "  .card.is-selected { border-color: #202124; }",
          "`);"
        ],
        "en": [
          "// The picked color (none at first)",
          "let selected = null;",
          "",
          "// We redefine createCard(): a click picks the color",
          "function createCard(color) {",
          "  const card = document.createElement(\"article\");",
          "  card.className = \"card\";",
          "  card.classList.toggle(\"is-selected\", color === selected);",
          "  card.innerHTML = `",
          "    <div class=\"swatch\" style=\"background: ${color.hex}\"></div>",
          "    <strong>${color.name}</strong>",
          "    <code>${color.hex}</code>",
          "  `;",
          "  card.addEventListener(\"click\", () => {",
          "    selected = color;",
          "    header.querySelector(\"h1\").style.color = color.hex;",
          "    render();",
          "  });",
          "  return card;",
          "}",
          "render();",
          "",
          "css(`",
          "  .card { cursor: pointer; border: 3px solid transparent; transition: transform 0.15s; }",
          "  .card:hover { transform: translateY(-3px); }",
          "  .card.is-selected { border-color: #202124; }",
          "`);"
        ]
      }
    },
    {
      "title": {
        "fr": "Thème sombre",
        "en": "Dark theme"
      },
      "prompt": {
        "fr": "Ajoute un bouton dans l'en-tête qui bascule toute la page entre un thème clair et un thème sombre.",
        "en": "Add a button in the header that switches the whole page between a light theme and a dark theme."
      },
      "code": {
        "fr": [
          "// Un bouton qui bascule le thème",
          "const themeButton = document.createElement(\"button\");",
          "themeButton.textContent = \"Thème sombre\";",
          "header.append(themeButton);",
          "",
          "themeButton.addEventListener(\"click\", () => {",
          "  const dark = document.body.classList.toggle(\"dark\");",
          "  themeButton.textContent = dark ? \"Thème clair\" : \"Thème sombre\";",
          "});",
          "",
          "// Le thème sombre surcharge les styles précédents",
          "css(`",
          "  header button { font: inherit; margin-left: 12px; padding: 10px 16px; border: 0; border-radius: 999px; background: #202124; color: #fff; cursor: pointer; }",
          "  body { transition: background 0.3s, color 0.3s; }",
          "  body.dark { background: #202124; color: #f8f9fa; }",
          "  body.dark header p { color: #9aa0a6; }",
          "  body.dark .card { background: #303134; }",
          "  body.dark .card.is-selected { border-color: #f8f9fa; }",
          "  body.dark header button { background: #f8f9fa; color: #202124; }",
          "`);"
        ],
        "en": [
          "// A button that switches the theme",
          "const themeButton = document.createElement(\"button\");",
          "themeButton.textContent = \"Dark theme\";",
          "header.append(themeButton);",
          "",
          "themeButton.addEventListener(\"click\", () => {",
          "  const dark = document.body.classList.toggle(\"dark\");",
          "  themeButton.textContent = dark ? \"Light theme\" : \"Dark theme\";",
          "});",
          "",
          "// The dark theme overrides the previous styles",
          "css(`",
          "  header button { font: inherit; margin-left: 12px; padding: 10px 16px; border: 0; border-radius: 999px; background: #202124; color: #fff; cursor: pointer; }",
          "  body { transition: background 0.3s, color 0.3s; }",
          "  body.dark { background: #202124; color: #f8f9fa; }",
          "  body.dark header p { color: #9aa0a6; }",
          "  body.dark .card { background: #303134; }",
          "  body.dark .card.is-selected { border-color: #f8f9fa; }",
          "  body.dark header button { background: #f8f9fa; color: #202124; }",
          "`);"
        ]
      }
    }
  ]
}
