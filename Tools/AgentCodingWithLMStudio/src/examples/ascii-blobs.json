{
  "title": {
    "fr": "Ascii Blobs",
    "en": "Ascii Blobs"
  },
  "mode": "vanilla",
  "steps": [
    {
      "title": {
        "fr": "Grille ASCII plein écran",
        "en": "ASCII Grid Setup"
      },
      "prompt": {
        "fr": "Créez une animation ASCII uniquement, sans canvas. Utilisez uniquement des lettres et des chiffres. Affichez-la en plein écran.",
        "en": "Create an animation using only ASCII, without a canvas. Use only letters and numbers. Display it in fullscreen."
      },
      "code": {
        "fr": [
          "// Création de l'élément d'affichage plein écran",
          "const preElement = document.createElement(\"pre\");",
          "preElement.style.margin = \"0\";",
          "preElement.style.padding = \"0\";",
          "preElement.style.backgroundColor = \"#000000\";",
          "preElement.style.color = \"#00ff66\";",
          "preElement.style.fontFamily = \"monospace\";",
          "preElement.style.fontSize = \"12px\";",
          "preElement.style.lineHeight = \"12px\";",
          "preElement.style.overflow = \"hidden\";",
          "preElement.style.width = \"100vw\";",
          "preElement.style.height = \"100vh\";",
          "preElement.style.position = \"fixed\";",
          "preElement.style.top = \"0\";",
          "preElement.style.left = \"0\";",
          "preElement.style.zIndex = \"9999\";",
          "preElement.style.userSelect = \"none\";",
          "document.body.appendChild(preElement);",
          "",
          "// Jeu de caractères alphanumériques uniquement",
          "const chars = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\";",
          "let cols = Math.floor(window.innerWidth / 7.2);",
          "let rows = Math.floor(window.innerHeight / 12);",
          "let time = 0;",
          "",
          "// Ajuste les dimensions lors du redimensionnement",
          "window.addEventListener(\"resize\", function () {",
          "  cols = Math.floor(window.innerWidth / 7.2);",
          "  rows = Math.floor(window.innerHeight / 12);",
          "});",
          "",
          "// Calcule le caractère pour une position donnée",
          "function getAsciiChar(x, y, t) {",
          "  const nx = (x - cols / 2) / (cols / 4);",
          "  const ny = (y - rows / 2) / (rows / 4);",
          "  const dist = Math.sqrt(nx * nx + ny * ny);",
          "  const wave = Math.sin(dist * 3 - t * 4) + Math.cos(nx * 2 + t) * Math.sin(ny * 2 - t);",
          "  const normalized = Math.floor(((wave + 2) / 4) * chars.length);",
          "  const index = Math.max(0, Math.min(chars.length - 1, normalized));",
          "  return chars[index];",
          "}",
          "",
          "// Génère la grille complète de texte",
          "function renderFrame() {",
          "  let output = \"\";",
          "  for (let y = 0; y < rows; y++) {",
          "    for (let x = 0; x < cols; x++) {",
          "      output += getAsciiChar(x, y, time);",
          "    }",
          "    output += \"\\n\";",
          "  }",
          "  preElement.textContent = output;",
          "}",
          "",
          "// Boucle principale d'animation",
          "function loop() {",
          "  time += 0.03;",
          "  renderFrame();",
          "  requestAnimationFrame(loop);",
          "}",
          "",
          "// Lancement de l'animation",
          "requestAnimationFrame(loop);"
        ],
        "en": [
          "// Creation of the fullscreen display element",
          "const preElement = document.createElement(\"pre\");",
          "preElement.style.margin = \"0\";",
          "preElement.style.padding = \"0\";",
          "preElement.style.backgroundColor = \"#000000\";",
          "preElement.style.color = \"#00ff66\";",
          "preElement.style.fontFamily = \"monospace\";",
          "preElement.style.fontSize = \"12px\";",
          "preElement.style.lineHeight = \"12px\";",
          "preElement.style.overflow = \"hidden\";",
          "preElement.style.width = \"100vw\";",
          "preElement.style.height = \"100vh\";",
          "preElement.style.position = \"fixed\";",
          "preElement.style.top = \"0\";",
          "preElement.style.left = \"0\";",
          "preElement.style.zIndex = \"9999\";",
          "preElement.style.userSelect = \"none\";",
          "document.body.appendChild(preElement);",
          "",
          "// Alphanumeric character set only",
          "const chars = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\";",
          "let cols = Math.floor(window.innerWidth / 7.2);",
          "let rows = Math.floor(window.innerHeight / 12);",
          "let time = 0;",
          "",
          "// Adjust dimensions on resize",
          "window.addEventListener(\"resize\", function () {",
          "  cols = Math.floor(window.innerWidth / 7.2);",
          "  rows = Math.floor(window.innerHeight / 12);",
          "});",
          "",
          "// Calculate the character for a given position",
          "function getAsciiChar(x, y, t) {",
          "  const nx = (x - cols / 2) / (cols / 4);",
          "  const ny = (y - rows / 2) / (rows / 4);",
          "  const dist = Math.sqrt(nx * nx + ny * ny);",
          "  const wave = Math.sin(dist * 3 - t * 4) + Math.cos(nx * 2 + t) * Math.sin(ny * 2 - t);",
          "  const normalized = Math.floor(((wave + 2) / 4) * chars.length);",
          "  const index = Math.max(0, Math.min(chars.length - 1, normalized));",
          "  return chars[index];",
          "}",
          "",
          "// Generate the complete text grid",
          "function renderFrame() {",
          "  let output = \"\";",
          "  for (let y = 0; y < rows; y++) {",
          "    for (let x = 0; x < cols; x++) {",
          "      output += getAsciiChar(x, y, time);",
          "    }",
          "    output += \"\\n\";",
          "  }",
          "  preElement.textContent = output;",
          "}",
          "",
          "// Main animation loop",
          "function loop() {",
          "  time += 0.03;",
          "  renderFrame();",
          "  requestAnimationFrame(loop);",
          "}",
          "",
          "// Start the animation",
          "requestAnimationFrame(loop);"
        ]
      }
    },
    {
      "title": {
        "fr": "Dégradé radial pastel",
        "en": "Pastel Radial Gradient"
      },
      "prompt": {
        "fr": "Ralentir l'animation et créer un dégradé progressif de couleur arc-en-ciel pastel et radial depuis le centre de l'écran sur fond noir",
        "en": "Slow down the animation and create a smooth, radial pastel rainbow gradient originating from the center of the screen on a black background."
      },
      "code": {
        "fr": [
          "// Création d'un conteneur parent pour garantir le fond noir derrière le texte transparent",
          "const containerElement = document.createElement(\"div\");",
          "containerElement.style.position = \"fixed\";",
          "containerElement.style.top = \"0\";",
          "containerElement.style.left = \"0\";",
          "containerElement.style.width = \"100vw\";",
          "containerElement.style.height = \"100vh\";",
          "containerElement.style.backgroundColor = \"#000000\";",
          "containerElement.style.zIndex = \"9998\";",
          "containerElement.style.overflow = \"hidden\";",
          "document.body.appendChild(containerElement);",
          "",
          "// Déplacement de l'élément pre dans le conteneur noir avec un fond transparent",
          "containerElement.appendChild(preElement);",
          "preElement.style.backgroundColor = \"transparent\";",
          "",
          "// Dégradé radial arc-en-ciel aux teintes pastel douces appliqué sur le texte",
          "preElement.style.backgroundImage = \"radial-gradient(circle at center, #ffb3ba 0%, #ffdfba 18%, #ffffba 36%, #baffc9 54%, #bae1ff 72%, #d7baff 90%, #f1cbff 100%)\";",
          "preElement.style.webkitBackgroundClip = \"text\";",
          "preElement.style.backgroundClip = \"text\";",
          "preElement.style.webkitTextFillColor = \"transparent\";",
          "preElement.style.color = \"transparent\";",
          "",
          "// Animation encore plus ralentie avec une progression temporelle très douce",
          "function loop() {",
          "  time += 0.003;",
          "  renderFrame();",
          "  requestAnimationFrame(loop);",
          "}"
        ],
        "en": [
          "// Creation of a parent container to ensure a black background behind the transparent text",
          "const containerElement = document.createElement(\"div\");",
          "containerElement.style.position = \"fixed\";",
          "containerElement.style.top = \"0\";",
          "containerElement.style.left = \"0\";",
          "containerElement.style.width = \"100vw\";",
          "containerElement.style.height = \"100vh\";",
          "containerElement.style.backgroundColor = \"#000000\";",
          "containerElement.style.zIndex = \"9998\";",
          "containerElement.style.overflow = \"hidden\";",
          "document.body.appendChild(containerElement);",
          "",
          "// Moving the pre element into the black container with a transparent background",
          "containerElement.appendChild(preElement);",
          "preElement.style.backgroundColor = \"transparent\";",
          "",
          "// Soft pastel rainbow radial gradient applied to the text",
          "preElement.style.backgroundImage = \"radial-gradient(circle at center, #ffb3ba 0%, #ffdfba 18%, #ffffba 36%, #baffc9 54%, #bae1ff 72%, #d7baff 90%, #f1cbff 100%)\";",
          "preElement.style.webkitBackgroundClip = \"text\";",
          "preElement.style.backgroundClip = \"text\";",
          "preElement.style.webkitTextFillColor = \"transparent\";",
          "preElement.style.color = \"transparent\";",
          "",
          "// Even slower animation with very smooth time progression",
          "function loop() {",
          "  time += 0.003;",
          "  renderFrame();",
          "  requestAnimationFrame(loop);",
          "}"
        ]
      }
    }
  ]
}
